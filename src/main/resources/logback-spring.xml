<?xml version="1.0" encoding="UTF-8"?>
<!-- Todo el logging va a STDERR. Un solo byte de log en stdout corrompe el protocolo MCP.
     Claude Desktop captura stderr en %APPDATA%\Claude\logs\mcp-server-donatrack.log -->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
